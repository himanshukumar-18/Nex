# NEX — Environment variable template
#
# Copy this file to .env and fill in real values before starting Docker Compose.
#   cp .env.example .env
#
# NEVER commit .env to version control.
# NEVER use these placeholder values in production.
#
# Production secret management:
#   Inject secrets via your deployment platform's secret store:
#     - Docker Swarm secrets
#     - AWS Secrets Manager / Parameter Store
#     - GCP Secret Manager
#     - Kubernetes Secrets (sealed or external)
#   Do not use .env files on production servers.

# ─────────────────────────────────────────────────────────────────────────────
# Django backend
# ─────────────────────────────────────────────────────────────────────────────

# Required in all environments.
# Generate: python -c "import secrets; print(secrets.token_urlsafe(50))"
# Production: must be 50+ characters, random, and unique per deployment.
DJANGO_SECRET_KEY=change-me-generate-with-secrets-token-urlsafe-50

# Comma-separated list of hostnames Django will serve.
# Development: leave as-is (not enforced when DEBUG=True).
# Production: set to your exact public domain only, e.g. nex.example.com
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# ─────────────────────────────────────────────────────────────────────────────
# PostgreSQL
# ─────────────────────────────────────────────────────────────────────────────

POSTGRES_DB=nex
POSTGRES_USER=nex

# Required. Use a strong random password in all environments.
# In development Docker Compose, DATABASE_URL is constructed automatically from
# these POSTGRES_* values so they cannot silently disagree with each other.
POSTGRES_PASSWORD=change-me

# Optional database tuning (sensible defaults exist in settings)
# DB_CONN_MAX_AGE=60
# DB_CONN_HEALTH_CHECKS=true
# DB_CONNECT_TIMEOUT=10
# DB_STATEMENT_TIMEOUT_MS=30000
# DB_LOCK_TIMEOUT_MS=10000
# DB_IDLE_TRANSACTION_TIMEOUT_MS=60000

# ─────────────────────────────────────────────────────────────────────────────
# DATABASE_URL (production only)
# ─────────────────────────────────────────────────────────────────────────────
#
# In development, docker-compose.yml constructs DATABASE_URL from POSTGRES_*
# variables above. Do not set DATABASE_URL in your development .env — it will
# be ignored by the dev Compose file.
#
# In production (docker-compose.prod.yml), set DATABASE_URL explicitly:
#   DATABASE_URL=postgres://nex:<POSTGRES_PASSWORD>@postgres:5432/nex
#
# Leave the line below commented out for development.
# DATABASE_URL=postgres://nex:change-me@postgres:5432/nex

# ─────────────────────────────────────────────────────────────────────────────
# Redis
# ─────────────────────────────────────────────────────────────────────────────

# Development: no password required.
REDIS_URL=redis://redis:6379/0

# Production only — Redis requires authentication.
# Must be a strong random password. Required by docker-compose.prod.yml.
# REDIS_PASSWORD=change-me

# ─────────────────────────────────────────────────────────────────────────────
# Rate limiting
# ─────────────────────────────────────────────────────────────────────────────
#
# RATE_LIMIT_HMAC_SECRET — Secret key used to HMAC-mask client IDs (IP addresses
#   and user IDs) in Redis rate-limit keys. Prevents cleartext exposure in Redis
#   key dumps. Must be a strong random value in production.
#   Generate: python -c "import secrets; print(secrets.token_hex(32))"
#
# RATE_LIMIT_FAIL_OPEN — Controls behavior when Redis is unreachable:
#   true (default): allow requests through (availability over strict enforcement)
#   false: block requests when Redis is unreachable (strict enforcement)
#
# NUM_PROXIES — Number of trusted upstream reverse proxies for IP resolution.
#   0: direct connections (trust REMOTE_ADDR only)
#   1: single proxy (default: Nginx in Docker Compose)
#   Increase when behind a CDN or additional load balancer.
#
RATE_LIMIT_HMAC_SECRET=change-me-generate-with-secrets-token-hex-32
RATE_LIMIT_FAIL_OPEN=true
NUM_PROXIES=1

# ─────────────────────────────────────────────────────────────────────────────
# Inter-Service Communication (Django Backend ↔ FastAPI Agent Runtime)
# ─────────────────────────────────────────────────────────────────────────────

# Internal Docker network URL for the FastAPI Agent Runtime (called by Django)
AGENT_RUNTIME_URL=http://agent-runtime:8001

# Shared secret for internal service-to-service authentication.
# Generate: python -c "import secrets; print(secrets.token_hex(32))"
# Required in production.
INTERNAL_SERVICE_SECRET=change-me-internal-service-secret-generate-hex-32

# Secondary secret to allow zero-downtime secret rotation without outage.
# Set during rotation, deploy both services, then decommission old secret.
# INTERNAL_SERVICE_SECRET_FALLBACK=

# ─────────────────────────────────────────────────────────────────────────────
# Agent runtime
# ─────────────────────────────────────────────────────────────────────────────

APP_ENV=development
APP_DEBUG=false

# Internal Docker network URL for the Django backend service.
BACKEND_URL=http://backend:8000

# Agent runtime Redis instance (DB 1 isolated from Django DB 0)
# REDIS_URL=redis://redis:6379/1

# ─────────────────────────────────────────────────────────────────────────────
# Firebase Authentication & Identity Security (Step 10)
# ─────────────────────────────────────────────────────────────────────────────

# Django Backend — Firebase Admin SDK credentials
FIREBASE_PROJECT_ID=nex-platform
FIREBASE_CREDENTIALS_PATH=/run/secrets/firebase-service-account.json
# FIREBASE_CREDENTIALS_JSON={"type":"service_account",...}

# React Frontend — Firebase Web Client Configuration
VITE_FIREBASE_API_KEY=AIzaSyExampleKeyForFirebaseClientWebAccess
VITE_FIREBASE_AUTH_DOMAIN=nex-platform.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=nex-platform
VITE_FIREBASE_STORAGE_BUCKET=nex-platform.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=123456789012
VITE_FIREBASE_APP_ID=1:123456789012:web:abcdef1234567890

# Python CLI Authentication
# NEX_FRONTEND_URL=http://localhost:3000
# NEX_API_KEY=nex_cli_example_token_override_for_ci

# ─────────────────────────────────────────────────────────────────────────────
# GitHub App Authorization & Repository Integration
# ─────────────────────────────────────────────────────────────────────────────

# Django Backend — GitHub App Credentials (backend only, never exposed to React or CLI)
GITHUB_APP_ID=
GITHUB_APP_SLUG=nex-engineering-assistant
GITHUB_APP_CLIENT_ID=
GITHUB_APP_CLIENT_SECRET=
GITHUB_APP_PRIVATE_KEY_PATH=/run/secrets/github-app-private-key.pem
# GITHUB_APP_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\n..."
GITHUB_WEBHOOK_SECRET=
GITHUB_APP_CALLBACK_URL=http://localhost:3000/settings
