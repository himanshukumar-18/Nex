# NEX Frontend — Environment Configuration
# Copy this file to .env before starting Vite development server:
#   cp .env.example .env

# Base URL for Django REST API.
# In local development through Vite dev proxy, '/api/v1' proxies to http://localhost:8080.
VITE_API_BASE_URL=/api/v1
VITE_APP_TITLE=NEX — Autonomous Intelligence for Software Engineering

