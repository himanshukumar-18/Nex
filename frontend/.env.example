# NEX Frontend — Environment Configuration Template
# Copy this file to .env before starting Vite development server:
#   cp .env.example .env
#
# NEVER commit real secret credentials to version control.

# ─────────────────────────────────────────────────────────────────────────────
# API Gateway & Backend Connectivity
# ─────────────────────────────────────────────────────────────────────────────

# Base URL for Django REST API.
# In development using the Vite reverse proxy: '/api/v1' proxies to http://backend:8000 (Docker) or http://localhost:8080 (Host).
VITE_API_BASE_URL=/api/v1

# Axios request timeout in milliseconds (default: 15000ms = 15s)
VITE_API_TIMEOUT=15000

# Target for Vite development server proxy
VITE_BACKEND_PROXY_TARGET=http://localhost:8080

# Application Branding
VITE_APP_TITLE=NEX — Autonomous Intelligence for Software Engineering

# ─────────────────────────────────────────────────────────────────────────────
# Firebase Client Authentication
# ─────────────────────────────────────────────────────────────────────────────

VITE_FIREBASE_API_KEY=AIzaSyExampleKeyForFirebaseClientWebAccess
VITE_FIREBASE_AUTH_DOMAIN=nex-platform.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=nex-platform
VITE_FIREBASE_STORAGE_BUCKET=nex-platform.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=123456789012
VITE_FIREBASE_APP_ID=1:123456789012:web:abcdef1234567890
